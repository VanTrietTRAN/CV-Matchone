# ─── AI Service (FastAPI) ──────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
# Thiếu key -> /health trả về "degraded" và /get-embedding luôn trả embedding = null
GEMINI_API_KEY=your_gemini_api_key_here

# Model embedding (tùy chọn — mặc định như dưới)
# Lưu ý: gemini-3.x-flash là model sinh nội dung, KHÔNG dùng cho embedding
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Số chiều vector. Đổi giá trị này thì phải tạo lại toàn bộ embedding trong DB.
GEMINI_EMBEDDING_DIMS=768
