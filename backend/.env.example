# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # development | production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Lấy từ Atlas → Connect → Drivers → copy connection string
# Nhớ thêm tên database: .../smart_recruit?...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_recruit?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Có thể đặt nhiều origin, cách nhau bởi dấu phẩy
# VD production: CLIENT_ORIGIN=https://cvoneclickmatch.com,https://www.cvoneclickmatch.com
CLIENT_ORIGIN=http://localhost:3000

# URL frontend dùng để tạo link trong email (đặt lại mật khẩu, gợi ý việc làm...)
FRONTEND_URL=http://localhost:3000

# ─── AI Service (FastAPI) ──────────────────────────────────────────────────────
# Bỏ trống -> backend bỏ qua embedding & matching (điểm phù hợp = 0)
AI_SERVICE_URL=http://localhost:8000

# ─── Gemini AI ─────────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── LLM bóc tách CV (mặc định: Groq) ─────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Ghi đè provider nếu muốn dùng dịch vụ khác tương thích OpenAI API
# LLM_API_KEY=            # mặc định lấy GROQ_API_KEY
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ─── Email / SMTP (Brevo) ──────────────────────────────────────────────────────
# Hướng dẫn từng bước: BREVO-EMAIL.md (thư mục gốc repo)
# Lấy thông tin tại Brevo → bánh răng (Settings) → SMTP & API
#
# EMAIL_USER: SMTP login, LUÔN có dạng xxxxxx@smtp-brevo.com.
#             KHÔNG phải email đăng nhập tài khoản Brevo.
# EMAIL_PASS: SMTP key, bắt đầu bằng "xsmtpsib-".
#             KHÔNG phải API key ("xkeysib-") — dán nhầm sẽ bị lỗi 535.
#             Dán cẩn thận, dính một dấu cách thừa cũng lỗi 535.
# SENDER_EMAIL: phải thuộc tên miền đã xác thực trong Brevo, nếu không thư sẽ
#             bị từ chối hoặc rơi vào spam.
#
# Kiểm tra sau khi đặt: GET /health?email=1, hoặc nút "Kiểm tra kết nối SMTP"
# ở trang Quản trị → Hệ thống.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_login@smtp-brevo.com
EMAIL_PASS=xsmtpsib-your_brevo_smtp_key
SENDER_EMAIL=CVMatchOne <no-reply@cvoneclickmatch.com>
# REPLY_TO: hộp thư nhận khi người dùng bấm "Trả lời". Địa chỉ gửi là no-reply và
# tên miền gốc không tự nhận thư — để trống thì thư trả lời bị trả lại.
# Tạo miễn phí bằng Cloudflare Email Routing, xem BREVO-EMAIL.md mục 8.3.
REPLY_TO=CVMatchOne <support@cvoneclickmatch.com>
# Tên biến thay thế (được đọc khi EMAIL_USER/EMAIL_PASS trống):
# BREVO_USER=
# BREVO_SMTP_KEY=
# Tên miền email trường khi import sinh viên có bật "gửi tới email trường":
# thư gửi thêm tới <MSSV>@<tên miền>. Mặc định sv1.dut.udn.vn.
# SCHOOL_EMAIL_DOMAIN=sv1.dut.udn.vn

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Nhớ thêm callback URL: https://your-api-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Facebook OAuth ────────────────────────────────────────────────────────────
# Meta Developers → App → Facebook Login → Settings
# Nhớ thêm callback URL: https://your-api-domain/api/auth/facebook/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ─── Cloudflare R2 (lưu file CV) ──────────────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Bỏ trống cả 4 biến -> file CV được lưu thẳng trong MongoDB (collection cvfiles).
# Import CV và bóc tách AI vẫn chạy bình thường; chỉ khác chỗ cất file.
# Kiểm tra đang dùng đường nào: GET /health -> trường "storage.driver".
# Đặt đủ 4 biến thì hệ thống tự chuyển sang R2 sau khi Restart.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=smart-recruit-cvs

# ─── Sentry (giám sát lỗi) ────────────────────────────────────────────────────
# https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN=https://your_dsn@sentry.io/your_project_id

# ─── Cookie Domain (tùy chọn, khi dùng subdomain) ─────────────────────────────
# COOKIE_DOMAIN=.cvoneclickmatch.com

# ─── Script kiểm thử (src/scripts/smokeTest.js) ───────────────────────────────
# TEST_API_URL=http://localhost:5000
