# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # development | production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Lấy từ Atlas → Connect → Drivers → copy connection string
# Nhớ thêm tên database: .../smart_recruit?...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_recruit?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Có thể đặt nhiều origin, cách nhau bởi dấu phẩy
# VD production: CLIENT_ORIGIN=https://smartrecruit.vn,https://www.smartrecruit.vn
CLIENT_ORIGIN=http://localhost:3000

# URL frontend dùng để tạo link trong email (đặt lại mật khẩu, gợi ý việc làm...)
FRONTEND_URL=http://localhost:3000

# ─── AI Service (FastAPI) ──────────────────────────────────────────────────────
# Bỏ trống -> backend bỏ qua embedding & matching (điểm phù hợp = 0)
AI_SERVICE_URL=http://localhost:8000

# ─── Gemini AI ─────────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── LLM bóc tách CV (mặc định: Groq) ─────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Ghi đè provider nếu muốn dùng dịch vụ khác tương thích OpenAI API
# LLM_API_KEY=            # mặc định lấy GROQ_API_KEY
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ─── Email / SMTP (Brevo) ──────────────────────────────────────────────────────
# https://app.brevo.com → SMTP & API → SMTP
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_login@smtp-brevo.com
EMAIL_PASS=your_brevo_smtp_key
SENDER_EMAIL=Smart Recruit <no-reply@smartrecruit.vn>
# Tên biến thay thế (được đọc khi EMAIL_USER/EMAIL_PASS trống):
# BREVO_USER=
# BREVO_SMTP_KEY=
# RESEND_API_KEY=        # legacy, chỉ dùng làm mật khẩu SMTP dự phòng

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Nhớ thêm callback URL: https://your-api-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Facebook OAuth ────────────────────────────────────────────────────────────
# Meta Developers → App → Facebook Login → Settings
# Nhớ thêm callback URL: https://your-api-domain/api/auth/facebook/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ─── Cloudflare R2 (lưu file CV) ──────────────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Bỏ trống -> file CV lưu tạm trên đĩa của server
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=smart-recruit-cvs

# ─── Sentry (giám sát lỗi) ────────────────────────────────────────────────────
# https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN=https://your_dsn@sentry.io/your_project_id

# ─── Cookie Domain (tùy chọn, khi dùng subdomain) ─────────────────────────────
# COOKIE_DOMAIN=.smartrecruit.vn

# ─── Script kiểm thử (src/scripts/smokeTest.js) ───────────────────────────────
# TEST_API_URL=http://localhost:5000
